{
  "name": "apirequests",
  "version": "2.0.1",
  "description": "Simple multiple configurable API requests.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "apirequests": "bin/apirequests.js"
  },
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "test": "ava",
    "test:e2e": "E2E_LIVE=1 ava test/test.e2e.js",
    "coverage": "c8 ava",
    "lint": "eslint lib/ index.js test/ bin/",
    "audit:prod": "npm audit --omit=dev",
    "prepack": "npm run lint && npm test",
    "prepublishOnly": "npm run lint && npm test"
  },
  "author": "DBProductions",
  "homepage": "https://github.com/DBProductions/apirequests",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DBProductions/apirequests.git"
  },
  "bugs": {
    "url": "https://github.com/DBProductions/apirequests/issues"
  },
  "keywords": [
    "api",
    "request",
    "test"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-spinner": "^0.2.10",
    "joi": "^18.3.2",
    "js-yaml": "^5.5.0",
    "log-symbols": "^7.0.1",
    "mongodb": "^7.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "ava": "^8.4.0",
    "c8": "^12.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-n": "^18.5.0",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.14.0"
  },
  "overrides": {
    "lodash": "4.18.1",
    "minimatch": "11.0.5",
    "glob": "14.0.4",
    "supertap": {
      "js-yaml": "3.15.2"
    }
  }
}
